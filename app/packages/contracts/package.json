{
  "name": "@teststand/contracts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./operations": {
      "teststand-source": "./src/operations.ts",
      "types": "./dist/operations.d.ts",
      "default": "./dist/operations.js"
    },
    "./devices": {
      "teststand-source": "./src/devices.ts",
      "types": "./dist/devices.d.ts",
      "default": "./dist/devices.js"
    },
    "./errors": {
      "teststand-source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./monitor": {
      "teststand-source": "./src/monitor.ts",
      "types": "./dist/monitor.d.ts",
      "default": "./dist/monitor.js"
    },
    "./storage": {
      "teststand-source": "./src/storage.ts",
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./agents": {
      "teststand-source": "./src/agents.ts",
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./execution": {
      "teststand-source": "./src/execution.ts",
      "types": "./dist/execution.d.ts",
      "default": "./dist/execution.js"
    },
    "./wiring": {
      "teststand-source": "./src/wiring.ts",
      "types": "./dist/wiring.d.ts",
      "default": "./dist/wiring.js"
    },
    "./projects": {
      "teststand-source": "./src/projects.ts",
      "types": "./dist/projects.d.ts",
      "default": "./dist/projects.js"
    },
    "./desktop": {
      "teststand-source": "./src/desktop.ts",
      "types": "./dist/desktop.d.ts",
      "default": "./dist/desktop.js"
    },
    "./testing": {
      "teststand-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./observability": {
      "teststand-source": "./src/observability.ts",
      "types": "./dist/observability.d.ts",
      "default": "./dist/observability.js"
    }
  },
  "typesVersions": {
    "*": {
      "operations": [
        "./dist/operations.d.ts"
      ],
      "devices": [
        "./dist/devices.d.ts"
      ],
      "errors": [
        "./dist/errors.d.ts"
      ],
      "storage": [
        "./dist/storage.d.ts"
      ],
      "agents": [
        "./dist/agents.d.ts"
      ],
      "execution": [
        "./dist/execution.d.ts"
      ],
      "wiring": [
        "./dist/wiring.d.ts"
      ],
      "projects": [
        "./dist/projects.d.ts"
      ],
      "desktop": [
        "./dist/desktop.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ],
      "observability": [
        "./dist/observability.d.ts"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:types": "node scripts/generate-openapi-types.mjs"
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
