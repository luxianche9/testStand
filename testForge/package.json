{
  "name": "testforge",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @testforge/desktop dev",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/verify-production-build.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages apps --ext .ts,.tsx",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:e2e": "pnpm --filter @testforge/desktop test:e2e",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check:dependencies": "depcruise --config .dependency-cruiser.cjs packages apps/desktop/src --output-type err && knip --config knip.json --include \"dependencies,unlisted,exports,types,cycles\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:imports && pnpm check:dependencies && pnpm build",
    "verify:full": "pnpm verify && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "knip": "^6.32.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "ssh2",
      "electron"
    ],
    "patchedDependencies": {
      "@assistant-ui/react-opencode@0.2.18": "patches/@assistant-ui__react-opencode@0.2.18.patch"
    }
  }
}
