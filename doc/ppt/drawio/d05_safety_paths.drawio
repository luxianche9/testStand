<mxfile host="drawio"><diagram name="d05_safety_paths" id="d05_safety_paths"><mxGraphModel dx="700" dy="450" grid="1" gridSize="10" page="0" background="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="frame" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="700" height="450" as="geometry"/></mxCell>
<mxCell id="in1" value='&lt;b&gt;DC110V&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569;"&gt;原边电压 · 启动信号&lt;br&gt;次边各路电源&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#F1F5F9;fontColor=#111827;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="150" height="64" as="geometry"/></mxCell>
<mxCell id="in2" value='&lt;b&gt;ICBP 输出&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569;"&gt;或 IOM 数字输出&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#F1F5F9;fontColor=#111827;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="196" width="150" height="64" as="geometry"/></mxCell>
<mxCell id="in3" value='&lt;b&gt;网流 · 接地回流&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569;"&gt;线路滤波器电流&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#F1F5F9;fontColor=#111827;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="330" width="150" height="64" as="geometry"/></mxCell>
<mxCell id="psu" value='&lt;b&gt;PSU 电源启动监测卡&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#DBEAFE;"&gt;FPGA 六通道欠压监测&lt;br&gt;P24/N24/UZ 可移除、门槛可调&lt;br&gt;P5/P15/N15 固定&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#1D4ED8;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="0" width="220" height="136" as="geometry"/></mxCell>
<mxCell id="bin" value='&lt;b&gt;/BINEN 接 M&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569;"&gt;/BIN01–08 直接 IO 驱动&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#E4ECFF;fontColor=#111827;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="196" width="220" height="64" as="geometry"/></mxCell>
<mxCell id="pcm" value='&lt;b&gt;PCM 源边电流监测卡&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569;"&gt;减法器 → 整流平滑（Tgl3≈0.42 ms）&lt;br&gt;→ 限值比较 → Ttot 延时&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#E4ECFF;fontColor=#111827;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="200" y="316" width="220" height="92" as="geometry"/></mxCell>
<mxCell id="inh" value="INHIBIT · HTOT 全封锁" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#FEF2F2;fontColor=#111827;strokeColor=#DC2626;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="0" width="220" height="40" as="geometry"/></mxCell>
<mxCell id="nmi" value="/NMI · /RESETOUT → CPU" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#F1F5F9;fontColor=#111827;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="480" y="48" width="220" height="40" as="geometry"/></mxCell>
<mxCell id="asa" value="ASA 禁止：切断 BOCD 供电" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#FEF2F2;fontColor=#111827;strokeColor=#DC2626;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="96" width="220" height="40" as="geometry"/></mxCell>
<mxCell id="bocd" value='&lt;b&gt;BOCD 8 路 DC110V 输出&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569;"&gt;绕过 CPU 软件周期&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#FFF4E5;fontColor=#111827;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="480" y="196" width="220" height="64" as="geometry"/></mxCell>
<mxCell id="hs" value='&lt;span style="font-size:12px;color:#475569;"&gt;HSPER / LSPER：BOCD、PCM 共用封锁信号&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fillColor=none;strokeColor=none;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="480" y="268" width="220" height="34" as="geometry"/></mxCell>
<mxCell id="trip" value='&lt;b&gt;分主断&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#475569;"&gt;硬件触发，无需 CPU&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fillColor=#FEF2F2;fontColor=#111827;strokeColor=#DC2626;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="336" width="220" height="52" as="geometry"/></mxCell>
