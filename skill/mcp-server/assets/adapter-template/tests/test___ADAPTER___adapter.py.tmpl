from __future__ import annotations

import pytest
from hardwareharness_device_sdk.testing import check_device, dry_run_config, receive_until, serve
from __PACKAGE__ import DEVICE, __CLASS__

PUBLIC_TOOLS = {
    "get_server_info", "list_hardware", "get_hardware_info", "get_pinout", "list_streams", "get_panel",
    "__PREFIX___set_output", "__PREFIX___read_inputs", "__PREFIX___safe_state",
    "__PREFIX___stream_read", "__PREFIX___stream_start", "__PREFIX___stream_stop",
}


@pytest.fixture
def hh():
    with serve(__CLASS__) as harness:
        yield harness


def test_entry_point_and_compliance():
    assert DEVICE is __CLASS__
    assert check_device(__CLASS__) == []


def test_public_contract(hh):
    internal = {name for name, item in hh.tools.items() if item["_meta"]["hardwareharness"]["kind"] == "internal"}
    assert set(hh.tools) - internal == PUBLIC_TOOLS
    semantics = hh.tools["__PREFIX___set_output"]["_meta"]["hardwareharness"]["operationSemantics"]
    assert semantics["kind"] == "actuate"
    assert semantics["retry"] == "never_after_dispatch"
    assert semantics["safetyAction"]["toolName"] == "__PREFIX___safe_state"
    channel = hh.tools["__PREFIX___set_output"]["inputSchema"]["properties"]["channel"]
    assert (channel["minimum"], channel["maximum"]) == (0, 7)


def test_out_of_range_channel_never_reaches_driver(hh):
    driver = hh.service.device.driver
    before = list(driver.writes)
    result = hh.mcp.call_raw("__PREFIX___set_output", {"hardwareId": hh.hardware_id, "channel": 8, "level": True})
    assert result.get("isError") or not result["structuredContent"]["ok"]
    assert driver.writes == before


def test_write_publishes_shadow(hh):
    assert hh.call("set_output", channel=2, level=True)["ok"]
    assert hh.service.device.driver.outputs == 0b100
    read = hh.call("stream_read", streamId="do", cursor=0)["data"]
    assert read["items"][-1]["value"] == 0b100
    assert read["items"][-1]["source"] == "software_shadow"


def test_inputs_stream_samples_the_controller(hh):
    hh.service.device.driver.inputs = 0b1010
    assert hh.call("read_inputs")["data"] == {"bits": 0b1010, "count": 8}
    with hh.websocket("di", cursor=0) as socket:
        batch = receive_until(socket, lambda frame: frame["type"] == "batch" and frame["items"])
    assert batch["items"][-1]["value"] == 0b1010


def test_safe_state_drives_every_output_low(hh):
    hh.call("set_output", channel=0, level=True)
    assert hh.call("safe_state")["data"] == {"mask": 0}
    assert hh.service.device.driver.outputs == 0


def test_failed_write_keeps_last_accepted_state():
    device = __CLASS__(dry_run_config(__CLASS__))
    device.open()
    device.driver.write_outputs = lambda handle, mask: -1  # type: ignore[method-assign]
    with pytest.raises(Exception, match="rc=-1") as caught:
        device.set_output(1, True)
    assert caught.value.details == {"rc": -1, "requested": 0b10, "last_accepted": 0}


def test_panel_binds_existing_tools_and_streams(hh):
    items = {item["id"]: item for item in hh.call("get_panel")["data"]["items"]}
    assert items["do0"]["write"]["tool"] == "__PREFIX___set_output" and items["do0"]["confirm"]
    assert items["di"]["stream"] == "di" and items["di"]["bits"] == 8
