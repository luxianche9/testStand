from __future__ import annotations

import pytest
from teststand_device_sdk.testing import check_device, dry_run_config, receive_until, serve
from __PACKAGE__ import DEVICE, __CLASS__

PUBLIC_TOOLS = {
    "get_device_info", "list_hardware", "get_hardware_info",
    "__PREFIX___set_output", "__PREFIX___read_inputs", "__PREFIX___safe_state",
    "__PREFIX___stream_read",
}


@pytest.fixture
def hh():
    with serve(__CLASS__) as harness:
        yield harness


def test_entry_point_and_compliance():
    assert DEVICE is __CLASS__
    warnings: list[str] = []
    assert check_device(__CLASS__, warnings=warnings) == []
    assert warnings == []


def test_public_contract(hh):
    internal = {name for name, item in hh.tools.items() if item["_meta"]["teststand"]["kind"] == "internal"}
    assert set(hh.tools) - internal == PUBLIC_TOOLS
    semantics = hh.tools["__PREFIX___set_output"]["_meta"]["teststand"]["operationSemantics"]
    assert semantics["kind"] == "actuate"
    assert semantics["retry"] == "never_after_dispatch"
    assert semantics["safetyAction"]["toolName"] == "__PREFIX___safe_state"
    channel = hh.tools["__PREFIX___set_output"]["inputSchema"]["properties"]["channel"]
    assert (channel["minimum"], channel["maximum"]) == (0, 7)


def test_out_of_range_channel_never_reaches_driver(hh):
    driver = hh.host.device.driver
    before = list(driver.writes)
    result = hh.call_raw("__PREFIX___set_output", {"hardwareId": hh.hardware_id, "channel": 8, "level": True})
    assert result["ok"] is False
    assert driver.writes == before


def test_stream_declarations(hh):
    assert hh.device()["streams"] == [
        {"id": "do", "type": "bits", "width": 8, "bitLabels": [f"DO{n}" for n in range(8)],
         "label": "Accepted output mask", "kind": "setpoint"},
        {"id": "di", "type": "bits", "width": 8, "bitLabels": [f"DI{n}" for n in range(8)], "rateHz": 20.0,
         "kind": "measured"}]


def test_device_declaration(hh):
    document = hh.device()
    assert document["description"].startswith("__MANUFACTURER__ __MODEL__")
    assert {tool["name"]: tool["kind"] for tool in document["tools"]}["__PREFIX___set_output"] == "actuate"


def test_write_publishes_output_mask(hh):
    result = hh.call("set_output", operation_id="op-1", channel=2, level=True)
    assert result["ok"] and hh.host.device.driver.outputs == 0b100
    refs = result["meta"]["streamRefs"]
    assert [ref["streamId"] for ref in refs] == ["do"]
    records = hh.call("stream_read", streamId="do", fromSeq=refs[0]["fromSeq"])["data"]["records"]
    assert records[-1]["mask"] == 0b100 and records[-1]["op"] == "op-1"


def test_inputs_stream_samples_the_controller(hh):
    hh.host.device.driver.inputs = 0b1010
    assert hh.call("read_inputs")["data"] == {"bits": 0b1010, "count": 8}
    with hh.subscribe("di", cursor=0) as events:
        assert receive_until(events, lambda event: event["type"] == "hello")["streamType"] == "bits"
        batch = receive_until(events, lambda event: event["type"] == "batch" and event["records"])
    assert batch["records"][-1]["mask"] == 0b1010


def test_safe_state_drives_every_output_low(hh):
    hh.call("set_output", channel=0, level=True)
    assert hh.call("safe_state")["data"] == {"mask": 0}
    assert hh.host.device.driver.outputs == 0


def test_failed_write_keeps_last_accepted_state():
    device = __CLASS__(dry_run_config(__CLASS__))
    device.open()
    device.driver.write_outputs = lambda handle, mask: -1  # type: ignore[method-assign]
    with pytest.raises(Exception, match="rc=-1") as caught:
        device.set_output(1, True)
    assert caught.value.details == {"rc": -1, "requested": 0b10, "last_accepted": 0}
