{
  "note": "Manual UI reference only. No script imports this file or writes TestForge data. Add SIM_PC first, then import each matching .tfhw from that MCP Server's editor; do not import these bundles as passive hardware. Replace <SIM_HARDWARE_ROOT> and <YOUR_WINDOWS_USERNAME>.",
  "computer": {
    "id": "SIM_PC",
    "label": "本机虚拟硬件",
    "address": "127.0.0.1",
    "ssh": {
      "port": 22,
      "username": "<YOUR_WINDOWS_USERNAME>"
    }
  },
  "mcpToken": "testforge-sim-local-only",
  "servers": [
    {
      "serverId": "SIM_AI_MCP",
      "computerId": "SIM_PC",
      "bundle": "hardware_bundles/virtual-analog-input.tfhw",
      "label": "虚拟模拟输入卡",
      "hardwareId": "SIM_PC.SIM_AI_0",
      "url": "http://127.0.0.1:8101/mcp",
      "enabled": true,
      "lifecycle": {
        "statusCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\analog_input\\status.ps1'",
        "startCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\analog_input\\start.ps1'",
        "stopCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\analog_input\\stop.ps1'",
        "logPath": "<SIM_HARDWARE_ROOT>\\servers\\analog_input\\logs"
      }
    },
    {
      "serverId": "SIM_AO_MCP",
      "computerId": "SIM_PC",
      "bundle": "hardware_bundles/virtual-analog-output.tfhw",
      "label": "虚拟模拟输出卡",
      "hardwareId": "SIM_PC.SIM_AO_0",
      "url": "http://127.0.0.1:8102/mcp",
      "enabled": true,
      "lifecycle": {
        "statusCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\analog_output\\status.ps1'",
        "startCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\analog_output\\start.ps1'",
        "stopCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\analog_output\\stop.ps1'",
        "logPath": "<SIM_HARDWARE_ROOT>\\servers\\analog_output\\logs"
      }
    },
    {
      "serverId": "SIM_SERIAL_MCP",
      "computerId": "SIM_PC",
      "bundle": "hardware_bundles/virtual-serial-card.tfhw",
      "label": "虚拟串口通信卡",
      "hardwareId": "SIM_PC.SIM_SERIAL_0",
      "url": "http://127.0.0.1:8103/mcp",
      "enabled": true,
      "lifecycle": {
        "statusCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\serial\\status.ps1'",
        "startCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\serial\\start.ps1'",
        "stopCommand": "& '<SIM_HARDWARE_ROOT>\\servers\\serial\\stop.ps1'",
        "logPath": "<SIM_HARDWARE_ROOT>\\servers\\serial\\logs"
      }
    }
  ]
}
