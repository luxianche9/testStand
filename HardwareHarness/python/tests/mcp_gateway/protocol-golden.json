[
  {
    "name": "accept",
    "headers": {
      "accept": "application/json"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "initialize",
      "params": {
        "protocolVersion": "2025-03-26",
        "capabilities": {},
